# 복사해서 .env.local 로 쓰기 (cp .env.example .env.local). .env.local 은 gitignore 됨.

# 서버 주소. 폰에서 접속하므로 localhost 말고 PC IP 를 쓴다.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Mock 스위치. true(기본)면 명세 example 로 동작, 실제 서버 안 붙여도 됨.
# 백엔드에 실제로 붙일 때만 false 로 바꾼다.
EXPO_PUBLIC_USE_MOCK=true

# Mock 등록증 OCR 실패 재현 (USE_MOCK=true 일 때만). 비워 두면 항상 인식 성공.
# 값이 있으면 촬영 후 결과 조회 2번째에 실패한다. 바꾼 뒤에는 npx expo start -c 로 다시 켜야 반영됨.
#   OCR_FAILED          → "사진을 읽지 못했어요" (다시 찍기)
#   SPRING_UNAVAILABLE  → "일시적인 문제가 생겼어요" (다시 찍기)
#   WORKER_ERROR        → "문제가 생겼어요" (다시 찍기)
#   LOAD_ERROR          → 결과 조회 실패 (다시 시도 → 정상 진행)
EXPO_PUBLIC_MOCK_OCR_FAILURE=

# SOL 진입 토큰. 데모는 기본값(demo-e9-ph-reyes)으로 동작하므로 생략해도 됨.
# EXPO_PUBLIC_ENTRY_TOKEN=demo-e9-ph-reyes

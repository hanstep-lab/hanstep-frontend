# 복사해서 .env.local 로 쓰기 (cp .env.example .env.local). .env.local 은 gitignore 됨.

# 서버 주소. 폰에서 접속하므로 localhost 말고 PC IP 를 쓴다.
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Mock 스위치. true(기본)면 명세 example 로 동작, 실제 서버 안 붙여도 됨.
# 백엔드에 실제로 붙일 때만 false 로 바꾼다.
EXPO_PUBLIC_USE_MOCK=true

# SOL 진입 토큰. 데모는 기본값(demo-e9-nguyen)으로 동작하므로 생략해도 됨.
# EXPO_PUBLIC_ENTRY_TOKEN=demo-e9-nguyen
